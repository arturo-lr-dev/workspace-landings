---
const links = [
  { href: "#servicios", label: "Servicios" },
  { href: "#nosotros", label: "Nosotros" },
  { href: "#proceso", label: "Proceso" },
  { href: "#testimonios", label: "Testimonios" },
  { href: "#contacto", label: "Contacto" },
];
---

<nav id="navbar" class="navbar">
  <div class="container">
    <div class="nav-inner">
      <!-- Logo -->
      <a href="#" class="logo">
        <div class="logo-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
          </svg>
        </div>
        <div>
          <span class="logo-name">AutoTech</span>
          <span class="logo-sub">Taller Mecánico</span>
        </div>
      </a>

      <!-- Desktop links -->
      <div class="nav-links">
        {links.map((link) => (
          <a href={link.href} class="nav-link">{link.label}</a>
        ))}
        <a href="#contacto" class="nav-cta">Agendar Cita</a>
      </div>

      <!-- Mobile menu button -->
      <button id="mobile-menu-btn" class="menu-btn" aria-label="Abrir menú">
        <span class="menu-line"></span>
        <span class="menu-line"></span>
        <span class="menu-line menu-line--short"></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="mobile-menu">
    <div class="mobile-menu-inner">
      {links.map((link, i) => (
        <a href={link.href} class="mobile-link" style={`transition-delay: ${i * 80}ms`}>{link.label}</a>
      ))}
      <a href="#contacto" class="mobile-cta">Agendar Cita</a>
    </div>
  </div>
</nav>

<style is:global>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: transparent;
    transition: all 0.5s;
  }
  .navbar.scrolled {
    background: rgba(10, 31, 10, 0.95);
    backdrop-filter: blur(12px);
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.3);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 5rem;
    transition: all 0.5s;
  }
  .navbar.scrolled .nav-inner { height: 4rem; }

  /* Logo */
  .logo { display: flex; align-items: center; gap: 0.75rem; }
  .logo-icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.5rem;
    background: var(--verde-600);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    transition: background 0.3s;
  }
  .logo:hover .logo-icon { background: var(--acento); color: var(--verde-950); }
  .logo-icon svg { width: 1.5rem; height: 1.5rem; }
  .logo-name {
    display: block;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: white;
  }
  .logo-sub {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--verde-400);
    margin-top: -2px;
  }

  /* Desktop links */
  .nav-links { display: none; align-items: center; gap: 0.25rem; }
  @media (min-width: 1024px) { .nav-links { display: flex; } }
  .nav-link {
    padding: 0.5rem 1rem;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(255,255,255,0.7);
    transition: color 0.3s;
  }
  .nav-link:hover { color: var(--acento); }
  .nav-cta {
    margin-left: 1rem;
    padding: 0.625rem 1.5rem;
    background: var(--acento);
    color: var(--verde-950);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 2px;
    transition: background 0.3s;
  }
  .nav-cta:hover { background: white; }

  /* Menu button */
  .menu-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 2.5rem;
    height: 2.5rem;
    color: white;
    background: none;
    border: none;
    cursor: pointer;
  }
  @media (min-width: 1024px) { .menu-btn { display: none; } }
  .menu-line {
    display: block;
    width: 1.5rem;
    height: 2px;
    background: currentColor;
    transition: all 0.3s;
    transform-origin: center;
  }
  .menu-line--short { width: 1rem; margin-left: auto; }

  .menu-btn.active .menu-line:nth-child(1) { transform: translateY(8px) rotate(45deg); }
  .menu-btn.active .menu-line:nth-child(2) { opacity: 0; }
  .menu-btn.active .menu-line:nth-child(3) { width: 1.5rem; transform: translateY(-8px) rotate(-45deg); }

  /* Mobile menu */
  .mobile-menu {
    display: none;
    position: fixed;
    inset: 0;
    top: 5rem;
    z-index: 40;
    background: rgba(10,31,10,0.98);
    backdrop-filter: blur(20px);
    transform: translateX(-100%);
    transition: transform 0.5s ease-out, top 0.5s;
  }
  @media (max-width: 1023px) { .mobile-menu { display: block; } }
  .mobile-menu.open { transform: translateX(0); }
  .navbar.scrolled .mobile-menu { top: 4rem; }

  .mobile-menu-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    gap: 2rem;
  }
  .mobile-link {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(255,255,255,0.8);
    transition: color 0.3s;
  }
  .mobile-link:hover { color: var(--acento); }
  .mobile-cta {
    margin-top: 1rem;
    padding: 0.75rem 2rem;
    background: var(--acento);
    color: var(--verde-950);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: background 0.3s;
  }
  .mobile-cta:hover { background: white; }
</style>

<script>
  const navbar = document.getElementById("navbar");
  const menuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const mobileLinks = document.querySelectorAll(".mobile-link");

  // Scroll effect
  window.addEventListener("scroll", () => {
    if (window.scrollY > 60) {
      navbar?.classList.add("scrolled");
    } else {
      navbar?.classList.remove("scrolled");
    }
  });

  // Mobile menu toggle
  menuBtn?.addEventListener("click", () => {
    menuBtn.classList.toggle("active");
    mobileMenu?.classList.toggle("open");
    document.body.style.overflow = mobileMenu?.classList.contains("open") ? "hidden" : "";
  });

  // Close on link click
  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => {
      menuBtn?.classList.remove("active");
      mobileMenu?.classList.remove("open");
      document.body.style.overflow = "";
    });
  });
</script>
