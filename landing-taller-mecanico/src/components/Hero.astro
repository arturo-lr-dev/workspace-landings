---
---

<section id="hero" class="hero">
  <!-- Background -->
  <div class="hero-bg">
    <div class="hero-gradient"></div>
    <div class="hero-glow hero-glow--1"></div>
    <div class="hero-glow hero-glow--2"></div>
    <div class="hero-grid"></div>
    <div class="hero-gear hero-gear--1">
      <svg class="gear-spin" viewBox="0 0 200 200" fill="#c8ff00">
        <path d="M100 20 L108 40 L120 25 L122 48 L138 38 L134 60 L152 55 L142 75 L160 76 L145 92 L162 98 L145 108 L158 120 L138 122 L146 140 L126 134 L128 152 L110 142 L106 160 L96 144 L86 158 L82 140 L66 148 L70 130 L52 132 L62 114 L44 110 L58 98 L42 88 L58 80 L46 66 L64 64 L56 48 L74 52 L72 34 L88 44 L92 26Z"/>
        <circle cx="100" cy="100" r="30" fill="#0a1f0a"/>
      </svg>
    </div>
    <div class="hero-gear hero-gear--2">
      <svg class="gear-spin-reverse" viewBox="0 0 200 200" fill="#38a338">
        <path d="M100 20 L108 40 L120 25 L122 48 L138 38 L134 60 L152 55 L142 75 L160 76 L145 92 L162 98 L145 108 L158 120 L138 122 L146 140 L126 134 L128 152 L110 142 L106 160 L96 144 L86 158 L82 140 L66 148 L70 130 L52 132 L62 114 L44 110 L58 98 L42 88 L58 80 L46 66 L64 64 L56 48 L74 52 L72 34 L88 44 L92 26Z"/>
        <circle cx="100" cy="100" r="30" fill="#0a1f0a"/>
      </svg>
    </div>
  </div>

  <!-- Content -->
  <div class="hero-content container">
    <div class="hero-grid-layout">
      <div class="hero-left">
        <div class="reveal hero-badge">
          <span class="hero-badge-dot pulse"></span>
          <span class="hero-badge-text">+20 años de experiencia</span>
        </div>

        <h1 class="reveal anim-delay-1 hero-title">
          <span>Tu auto</span>
          <span class="text-gradient-green">merece</span>
          <span>lo mejor</span>
        </h1>

        <p class="reveal anim-delay-2 hero-desc">
          Servicio automotriz profesional con tecnología de punta y técnicos certificados.
          Diagnóstico preciso, reparación garantizada.
        </p>

        <div class="reveal anim-delay-3 hero-ctas">
          <a href="#contacto" class="btn-primary">
            <span class="btn-primary-label">Agendar Cita</span>
            <span class="btn-primary-hover"></span>
          </a>
          <a href="#servicios" class="btn-outline">Ver Servicios</a>
        </div>

        <div class="reveal anim-delay-4 hero-stats">
          <div class="stat">
            <span class="stat-num stat-num--accent">20+</span>
            <span class="stat-label">Años</span>
          </div>
          <div class="stat">
            <span class="stat-num">5K+</span>
            <span class="stat-label">Clientes</span>
          </div>
          <div class="stat">
            <span class="stat-num">100%</span>
            <span class="stat-label">Garantía</span>
          </div>
        </div>
      </div>

      <!-- Diagnostic card -->
      <div class="reveal-right anim-delay-3 hero-right">
        <div class="diag-card">
          <div class="diag-header">
            <span class="diag-dot" style="background:var(--verde-500)"></span>
            <span class="diag-dot" style="background:var(--acento)"></span>
            <span class="diag-dot" style="background:var(--verde-300)"></span>
            <span class="diag-title">diagnostico_v4.2</span>
          </div>
          <div class="diag-rows">
            <div class="diag-row"><span class="diag-name">Motor</span><div class="diag-bar-wrap"><div class="diag-bar" style="width:92%"></div></div><span class="diag-pct diag-pct--accent">92%</span></div>
            <div class="diag-row"><span class="diag-name">Frenos</span><div class="diag-bar-wrap"><div class="diag-bar diag-bar--green" style="width:78%"></div></div><span class="diag-pct">78%</span></div>
            <div class="diag-row"><span class="diag-name">Suspensión</span><div class="diag-bar-wrap"><div class="diag-bar" style="width:85%"></div></div><span class="diag-pct diag-pct--accent">85%</span></div>
            <div class="diag-row"><span class="diag-name">Eléctrico</span><div class="diag-bar-wrap"><div class="diag-bar" style="width:96%"></div></div><span class="diag-pct diag-pct--accent">96%</span></div>
            <div class="diag-row"><span class="diag-name">Transmisión</span><div class="diag-bar-wrap"><div class="diag-bar" style="width:88%"></div></div><span class="diag-pct diag-pct--accent">88%</span></div>
          </div>
          <div class="diag-footer">
            <div class="diag-status"><span class="diag-status-dot pulse"></span><span>ESTADO: ÓPTIMO</span></div>
            <span class="diag-id">ID: #VH-4892</span>
          </div>
        </div>
        <div class="diag-float">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>
          <div><span class="diag-float-title">Diagnóstico</span><span class="diag-float-sub">Gratuito</span></div>
        </div>
      </div>
    </div>
  </div>

  <div class="reveal anim-delay-5 hero-scroll">
    <span>Scroll</span>
    <div class="hero-scroll-line pulse"></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--verde-950);
  }

  /* Background */
  .hero-bg { position: absolute; inset: 0; }
  .hero-gradient { position: absolute; inset: 0; background: linear-gradient(to bottom right, var(--verde-950), var(--verde-900), var(--verde-950)); }
  .hero-glow { position: absolute; border-radius: 50%; filter: blur(150px); }
  .hero-glow--1 { top: 33%; right: 25%; width: 800px; height: 800px; background: rgba(45, 138, 45, 0.15); }
  .hero-glow--2 { bottom: 0; left: 0; width: 600px; height: 600px; background: rgba(200, 255, 0, 0.05); filter: blur(120px); }
  .hero-grid {
    position: absolute; inset: 0; opacity: 0.04;
    background-image: linear-gradient(rgba(200,255,0,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(200,255,0,0.3) 1px, transparent 1px);
    background-size: 60px 60px;
  }
  .hero-gear { position: absolute; opacity: 0.06; }
  .hero-gear--1 { top: -5rem; right: -5rem; width: 20rem; height: 20rem; }
  .hero-gear--2 { bottom: 2.5rem; left: 2.5rem; width: 13rem; height: 13rem; opacity: 0.04; }
  .hero-gear svg { width: 100%; height: 100%; }

  /* Content */
  .hero-content { position: relative; z-index: 10; padding-top: 7rem; padding-bottom: 5rem; width: 100%; }
  .hero-grid-layout { display: grid; gap: 3rem; align-items: center; }
  @media (min-width: 1024px) {
    .hero-grid-layout { grid-template-columns: 1fr 1fr; gap: 4rem; }
  }

  /* Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 1rem;
    border: 1px solid rgba(45, 138, 45, 0.4);
    border-radius: 9999px;
    margin-bottom: 2rem;
  }
  .hero-badge-dot { width: 8px; height: 8px; background: var(--acento); border-radius: 50%; }
  .hero-badge-text { font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--verde-300); }

  /* Title */
  .hero-title {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    line-height: 0.9;
    letter-spacing: -0.025em;
  }
  .hero-title span { display: block; font-size: clamp(3rem, 8vw, 6rem); color: white; }
  .hero-title span:nth-child(2) { margin-top: 0.25rem; }
  .hero-title span:nth-child(3) { margin-top: 0.25rem; }
  @media (min-width: 1280px) {
    .hero-title span { font-size: 6rem; }
  }

  /* Desc */
  .hero-desc { margin-top: 2rem; font-size: 1.125rem; color: rgba(255,255,255,0.6); max-width: 32rem; line-height: 1.625; }

  /* CTAs */
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2.5rem; }
  .btn-primary {
    position: relative;
    padding: 1rem 2rem;
    background: var(--acento);
    color: var(--verde-950);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    overflow: hidden;
  }
  .btn-primary-label { position: relative; z-index: 1; }
  .btn-primary-hover {
    position: absolute;
    inset: 0;
    background: white;
    transform: translateY(100%);
    transition: transform 0.3s;
  }
  .btn-primary:hover .btn-primary-hover { transform: translateY(0); }
  .btn-outline {
    padding: 1rem 2rem;
    border: 1px solid rgba(56, 163, 56, 0.4);
    color: white;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all 0.3s;
  }
  .btn-outline:hover { border-color: var(--acento); color: var(--acento); }

  /* Stats */
  .hero-stats {
    display: flex;
    gap: 2.5rem;
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255,255,255,0.1);
  }
  .stat-num {
    display: block;
    font-family: var(--font-display);
    font-size: 1.875rem;
    font-weight: 700;
    color: white;
  }
  .stat-num--accent { color: var(--acento); }
  .stat-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.4);
    margin-top: 0.25rem;
  }
  @media (min-width: 1024px) {
    .stat-num { font-size: 2.25rem; }
  }

  /* Right column */
  .hero-right { display: none; position: relative; }
  @media (min-width: 1024px) {
    .hero-right { display: block; }
  }

  /* Diagnostic card */
  .diag-card {
    background: linear-gradient(to bottom right, rgba(26,74,26,0.5), rgba(15,46,15,0.8));
    border: 1px solid rgba(45,138,45,0.2);
    border-radius: 2px;
    padding: 2rem;
    backdrop-filter: blur(4px);
  }
  .diag-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 1rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid rgba(45,138,45,0.2);
  }
  .diag-dot { width: 12px; height: 12px; border-radius: 50%; }
  .diag-title { margin-left: 0.75rem; font-family: var(--font-mono); font-size: 0.75rem; color: var(--verde-400); }
  .diag-rows { display: flex; flex-direction: column; gap: 1rem; font-family: var(--font-mono); font-size: 0.875rem; }
  .diag-row { display: flex; justify-content: space-between; align-items: center; }
  .diag-name { color: var(--verde-400); }
  .diag-bar-wrap { width: 8rem; height: 8px; background: var(--verde-900); border-radius: 9999px; overflow: hidden; }
  .diag-bar { height: 100%; background: linear-gradient(to right, var(--verde-500), var(--acento)); border-radius: 9999px; }
  .diag-bar--green { background: linear-gradient(to right, var(--verde-500), var(--verde-300)); }
  .diag-pct { font-size: 0.75rem; color: var(--verde-300); }
  .diag-pct--accent { color: var(--acento); }
  .diag-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(45,138,45,0.2);
  }
  .diag-status { display: flex; align-items: center; gap: 0.5rem; font-family: var(--font-mono); font-size: 0.75rem; color: var(--verde-300); }
  .diag-status-dot { width: 8px; height: 8px; background: var(--acento); border-radius: 50%; }
  .diag-id { font-family: var(--font-mono); font-size: 0.75rem; color: var(--verde-500); }

  /* Floating card */
  .diag-float {
    position: absolute;
    bottom: -1.5rem;
    left: -1.5rem;
    background: var(--acento);
    color: var(--verde-950);
    padding: 0.75rem 1.25rem;
    border-radius: 2px;
    box-shadow: 0 25px 50px -12px rgba(0,0,0,0.4);
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .diag-float-title { display: block; font-family: var(--font-display); font-size: 0.875rem; font-weight: 700; text-transform: uppercase; }
  .diag-float-sub { display: block; font-family: var(--font-mono); font-size: 0.75rem; }

  /* Scroll indicator */
  .hero-scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .hero-scroll span { font-family: var(--font-mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.3em; color: var(--verde-500); }
  .hero-scroll-line { width: 1px; height: 2rem; background: linear-gradient(to bottom, var(--verde-500), transparent); }
</style>
