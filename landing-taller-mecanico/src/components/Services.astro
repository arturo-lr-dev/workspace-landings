---
const services = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-8 h-8"><path d="M12 8V4l8 8-8 8v-4H4V8h8z" /><path d="M4 4l4 4M20 20l-4-4M4 20l4-4M20 4l-4 4" /></svg>`,
    title: "Mecánica General",
    desc: "Reparación integral de motor, transmisión, embrague y sistemas de escape. Servicio completo para todas las marcas.",
    tag: "Popular",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-8 h-8"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>`,
    title: "Diagnóstico Electrónico",
    desc: "Escáner computarizado de última generación para detectar fallas con precisión milimétrica en todos los sistemas.",
    tag: "Gratis",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-8 h-8"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/><path d="M8 7h8M8 11h6"/></svg>`,
    title: "Servicio Preventivo",
    desc: "Cambio de aceite, filtros, bujías, líquido de frenos, refrigerante y más. Mantenimiento por kilometraje.",
    tag: "",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-8 h-8"><circle cx="12" cy="12" r="10"/><path d="M8 12h8M12 8v8"/></svg>`,
    title: "Sistema de Frenos",
    desc: "Cambio de pastillas, discos, tambores, líquido de frenos y reparación de ABS. Tu seguridad primero.",
    tag: "",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-8 h-8"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
    title: "Sistema Eléctrico",
    desc: "Alternador, motor de arranque, batería, cableado, luces y sistema de carga. Diagnóstico y reparación.",
    tag: "",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-8 h-8"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M12 6v6l4 2"/></svg>`,
    title: "Aire Acondicionado",
    desc: "Carga de gas, detección de fugas, reparación de compresor y limpieza del sistema de climatización.",
    tag: "",
  },
];
---

<section id="servicios" class="relative py-24 lg:py-32 bg-humo stripes-pattern overflow-hidden">
  <!-- Section accent -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-verde-500/30 to-transparent"></div>

  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <!-- Header -->
    <div class="max-w-2xl mb-16 lg:mb-20">
      <span class="reveal inline-block font-mono text-xs uppercase tracking-[0.3em] text-verde-600 mb-4">
        // Nuestros servicios
      </span>
      <h2 class="reveal delay-1 font-display text-4xl sm:text-5xl lg:text-6xl font-bold uppercase tracking-tight text-verde-950 leading-[0.95]">
        Soluciones<br/>
        <span class="text-verde-600">completas</span> para<br/>
        tu vehículo
      </h2>
      <p class="reveal delay-2 mt-6 text-lg text-acero/70 leading-relaxed">
        Contamos con equipos de última tecnología y técnicos certificados para ofrecer un servicio integral de calidad.
      </p>
    </div>

    <!-- Services grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-6">
      {services.map((service, i) => (
        <article class={`reveal delay-${i + 1} group relative bg-white border border-verde-100 rounded-sm p-7 lg:p-8 hover:border-verde-400 transition-all duration-500 hover:-translate-y-1 hover:shadow-xl hover:shadow-verde-600/5`}>
          {service.tag && (
            <span class="absolute top-4 right-4 px-2 py-0.5 bg-acento text-verde-950 text-[10px] font-mono font-bold uppercase tracking-wider">
              {service.tag}
            </span>
          )}

          <div class="w-14 h-14 bg-verde-50 border border-verde-100 rounded-sm flex items-center justify-center text-verde-600 group-hover:bg-verde-600 group-hover:text-white group-hover:border-verde-600 transition-all duration-300">
            <Fragment set:html={service.icon} />
          </div>

          <h3 class="mt-5 font-display text-xl font-bold uppercase tracking-wide text-verde-950 group-hover:text-verde-700 transition-colors">
            {service.title}
          </h3>

          <p class="mt-3 text-sm text-acero/70 leading-relaxed">
            {service.desc}
          </p>

          <div class="mt-5 flex items-center gap-2 text-verde-600 opacity-0 group-hover:opacity-100 translate-x-[-8px] group-hover:translate-x-0 transition-all duration-300">
            <span class="text-xs font-mono uppercase tracking-wider">Más info</span>
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
