---
const services = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="svc-icon-svg"><path d="M12 8V4l8 8-8 8v-4H4V8h8z"/><path d="M4 4l4 4M20 20l-4-4M4 20l4-4M20 4l-4 4"/></svg>`,
    title: "Mecánica General",
    desc: "Reparación integral de motor, transmisión, embrague y sistemas de escape. Servicio completo para todas las marcas.",
    tag: "Popular",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="svc-icon-svg"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>`,
    title: "Diagnóstico Electrónico",
    desc: "Escáner computarizado de última generación para detectar fallas con precisión milimétrica en todos los sistemas.",
    tag: "Gratis",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="svc-icon-svg"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/><path d="M8 7h8M8 11h6"/></svg>`,
    title: "Servicio Preventivo",
    desc: "Cambio de aceite, filtros, bujías, líquido de frenos, refrigerante y más. Mantenimiento por kilometraje.",
    tag: "",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="svc-icon-svg"><circle cx="12" cy="12" r="10"/><path d="M8 12h8M12 8v8"/></svg>`,
    title: "Sistema de Frenos",
    desc: "Cambio de pastillas, discos, tambores, líquido de frenos y reparación de ABS. Tu seguridad primero.",
    tag: "",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="svc-icon-svg"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
    title: "Sistema Eléctrico",
    desc: "Alternador, motor de arranque, batería, cableado, luces y sistema de carga. Diagnóstico y reparación.",
    tag: "",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="svc-icon-svg"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M12 6v6l4 2"/></svg>`,
    title: "Aire Acondicionado",
    desc: "Carga de gas, detección de fugas, reparación de compresor y limpieza del sistema de climatización.",
    tag: "",
  },
];
---

<section id="servicios" class="section stripes-bg" style="background-color:var(--humo)">
  <div class="section-line"></div>
  <div class="container">
    <div class="svc-header">
      <span class="reveal section-label" style="color:var(--verde-600)">// Nuestros servicios</span>
      <h2 class="reveal anim-delay-1 section-title svc-title">
        Soluciones<br/><span style="color:var(--verde-600)">completas</span> para<br/>tu vehículo
      </h2>
      <p class="reveal anim-delay-2 svc-subtitle">
        Contamos con equipos de última tecnología y técnicos certificados para ofrecer un servicio integral de calidad.
      </p>
    </div>

    <div class="svc-grid">
      {services.map((service, i) => (
        <article class={`reveal anim-delay-${i + 1} svc-card`}>
          {service.tag && <span class="svc-tag">{service.tag}</span>}
          <div class="svc-icon"><Fragment set:html={service.icon} /></div>
          <h3 class="svc-card-title">{service.title}</h3>
          <p class="svc-card-desc">{service.desc}</p>
          <div class="svc-more">
            <span>Más info</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .svc-header { max-width: 42rem; margin-bottom: 4rem; }
  @media (min-width: 1024px) { .svc-header { margin-bottom: 5rem; } }
  .svc-title { font-size: clamp(2.25rem, 5vw, 3.75rem); color: var(--verde-950); }
  .svc-subtitle { margin-top: 1.5rem; font-size: 1.125rem; color: rgba(74,74,72,0.7); line-height: 1.625; }

  .svc-grid { display: grid; gap: 1rem; }
  @media (min-width: 640px) { .svc-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .svc-grid { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; } }

  .svc-card {
    position: relative;
    background: white;
    border: 1px solid var(--verde-100);
    border-radius: 2px;
    padding: 1.75rem 2rem;
    transition: all 0.5s;
  }
  .svc-card:hover {
    border-color: var(--verde-400);
    transform: translateY(-4px);
    box-shadow: 0 20px 25px -5px rgba(45,138,45,0.05);
  }

  .svc-tag {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 2px 8px;
    background: var(--acento);
    color: var(--verde-950);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .svc-icon {
    width: 3.5rem;
    height: 3.5rem;
    background: var(--verde-50);
    border: 1px solid var(--verde-100);
    border-radius: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--verde-600);
    transition: all 0.3s;
  }
  .svc-card:hover .svc-icon { background: var(--verde-600); color: white; border-color: var(--verde-600); }
  :global(.svc-icon-svg) { width: 2rem; height: 2rem; }

  .svc-card-title {
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.025em;
    color: var(--verde-950);
    transition: color 0.3s;
  }
  .svc-card:hover .svc-card-title { color: var(--verde-700); }

  .svc-card-desc { margin-top: 0.75rem; font-size: 0.875rem; color: rgba(74,74,72,0.7); line-height: 1.625; }

  .svc-more {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    color: var(--verde-600);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0;
    transform: translateX(-8px);
    transition: all 0.3s;
  }
  .svc-card:hover .svc-more { opacity: 1; transform: translateX(0); }
</style>
