---
const testimonials = [
  {
    name: "Carlos Mendoza",
    role: "Toyota Corolla 2021",
    text: "Llegué con un problema eléctrico que nadie podía resolver. En AutoTech lo diagnosticaron en minutos y la reparación fue impecable. Precios justos y servicio honesto.",
    rating: 5,
  },
  {
    name: "María González",
    role: "Honda CR-V 2019",
    text: "Llevo 5 años trayendo mis autos aquí. La confianza que me dan no tiene precio. Siempre explican todo con detalle y nunca te cobran de más.",
    rating: 5,
  },
  {
    name: "Roberto Silva",
    role: "Ford F-150 2022",
    text: "El diagnóstico gratuito me ahorró miles de pesos. Me dijeron exactamente qué necesitaba mi camioneta y nada más. Profesionalismo total.",
    rating: 5,
  },
  {
    name: "Ana Martínez",
    role: "Volkswagen Jetta 2020",
    text: "Mi Jetta tenía un ruido extraño que me preocupaba mucho. Lo resolvieron el mismo día y me dieron garantía por escrito. Recomendadísimo.",
    rating: 5,
  },
];
---

<section id="testimonios" class="relative py-24 lg:py-32 bg-verde-950 overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-verde-600/8 rounded-full blur-[150px]"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="reveal inline-block font-mono text-xs uppercase tracking-[0.3em] text-verde-400 mb-4">
        // Testimonios
      </span>
      <h2 class="reveal anim-delay-1 font-display text-4xl sm:text-5xl lg:text-6xl font-bold uppercase tracking-tight text-white leading-[0.95]">
        Lo que dicen<br/><span class="text-gradient-green">nuestros clientes</span>
      </h2>
    </div>

    <!-- Testimonials grid -->
    <div class="grid md:grid-cols-2 gap-6">
      {testimonials.map((t, i) => (
        <div class={`reveal anim-delay-${i + 1} group relative bg-verde-900/40 border border-verde-700/20 rounded-sm p-8 hover:border-verde-500/30 transition-all duration-500`}>
          <!-- Stars -->
          <div class="flex gap-1 mb-5">
            {Array.from({length: t.rating}).map(() => (
              <svg class="w-4 h-4 text-acento" viewBox="0 0 20 20" fill="currentColor">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>

          <!-- Quote -->
          <p class="text-white/70 leading-relaxed text-sm lg:text-base">
            "{t.text}"
          </p>

          <!-- Author -->
          <div class="mt-6 pt-5 border-t border-verde-700/20 flex items-center gap-4">
            <div class="w-10 h-10 rounded-full bg-verde-700/50 flex items-center justify-center">
              <span class="text-sm font-display font-bold text-verde-300">
                {t.name.split(' ').map(n => n[0]).join('')}
              </span>
            </div>
            <div>
              <span class="block text-sm font-display font-bold text-white">{t.name}</span>
              <span class="block text-xs font-mono text-verde-500">{t.role}</span>
            </div>
          </div>

          <!-- Decorative quote mark -->
          <div class="absolute top-6 right-8 text-verde-800/30 font-display text-6xl leading-none select-none">"</div>
        </div>
      ))}
    </div>

    <!-- Trust bar -->
    <div class="reveal anim-delay-5 mt-16 flex flex-wrap items-center justify-center gap-8 lg:gap-16 py-8 border-t border-b border-white/5">
      <div class="text-center">
        <span class="block text-3xl font-display font-bold text-acento">4.9</span>
        <span class="block text-[10px] font-mono uppercase tracking-widest text-white/30 mt-1">Google Rating</span>
      </div>
      <div class="w-px h-8 bg-white/10 hidden sm:block"></div>
      <div class="text-center">
        <span class="block text-3xl font-display font-bold text-white">500+</span>
        <span class="block text-[10px] font-mono uppercase tracking-widest text-white/30 mt-1">Reseñas</span>
      </div>
      <div class="w-px h-8 bg-white/10 hidden sm:block"></div>
      <div class="text-center">
        <span class="block text-3xl font-display font-bold text-white">98%</span>
        <span class="block text-[10px] font-mono uppercase tracking-widest text-white/30 mt-1">Satisfacción</span>
      </div>
      <div class="w-px h-8 bg-white/10 hidden sm:block"></div>
      <div class="text-center">
        <span class="block text-3xl font-display font-bold text-white">5K+</span>
        <span class="block text-[10px] font-mono uppercase tracking-widest text-white/30 mt-1">Clientes</span>
      </div>
    </div>
  </div>
</section>
