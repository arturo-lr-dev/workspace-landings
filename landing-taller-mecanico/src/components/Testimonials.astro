---
const testimonials = [
  { name: "Carlos Mendoza", role: "Toyota Corolla 2021", text: "Llegué con un problema eléctrico que nadie podía resolver. En AutoTech lo diagnosticaron en minutos y la reparación fue impecable. Precios justos y servicio honesto.", rating: 5 },
  { name: "María González", role: "Honda CR-V 2019", text: "Llevo 5 años trayendo mis autos aquí. La confianza que me dan no tiene precio. Siempre explican todo con detalle y nunca te cobran de más.", rating: 5 },
  { name: "Roberto Silva", role: "Ford F-150 2022", text: "El diagnóstico gratuito me ahorró miles de pesos. Me dijeron exactamente qué necesitaba mi camioneta y nada más. Profesionalismo total.", rating: 5 },
  { name: "Ana Martínez", role: "Volkswagen Jetta 2020", text: "Mi Jetta tenía un ruido extraño que me preocupaba mucho. Lo resolvieron el mismo día y me dieron garantía por escrito. Recomendadísimo.", rating: 5 },
];

const trustMetrics = [
  { value: "4.9", label: "Google Rating", accent: true },
  { value: "500+", label: "Reseñas", accent: false },
  { value: "98%", label: "Satisfacción", accent: false },
  { value: "5K+", label: "Clientes", accent: false },
];
---

<section id="testimonios" class="section testi">
  <div class="testi-bg">
    <div class="testi-glow"></div>
  </div>
  <div class="container testi-inner">
    <div class="testi-header">
      <span class="reveal section-label" style="color:var(--verde-400)">// Testimonios</span>
      <h2 class="reveal anim-delay-1 section-title testi-title">
        Lo que dicen<br/><span class="text-gradient-green">nuestros clientes</span>
      </h2>
    </div>

    <div class="testi-grid">
      {testimonials.map((t, i) => (
        <div class={`reveal anim-delay-${i + 1} testi-card`}>
          <div class="testi-stars">
            {Array.from({length: t.rating}).map(() => (
              <svg class="testi-star" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            ))}
          </div>
          <p class="testi-text">"{t.text}"</p>
          <div class="testi-author">
            <div class="testi-avatar">{t.name.split(' ').map(n => n[0]).join('')}</div>
            <div>
              <span class="testi-name">{t.name}</span>
              <span class="testi-role">{t.role}</span>
            </div>
          </div>
          <div class="testi-quote">"</div>
        </div>
      ))}
    </div>

    <div class="reveal anim-delay-5 trust-bar">
      {trustMetrics.map((m, i) => (
        <>
          {i > 0 && <div class="trust-divider"></div>}
          <div class="trust-item">
            <span class={`trust-value ${m.accent ? 'trust-value--accent' : ''}`}>{m.value}</span>
            <span class="trust-label">{m.label}</span>
          </div>
        </>
      ))}
    </div>
  </div>
</section>

<style>
  .testi { background: var(--verde-950); }
  .testi-bg { position: absolute; inset: 0; }
  .testi-glow { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); width: 800px; height: 800px; background: rgba(45,138,45,0.08); border-radius: 50%; filter: blur(150px); }
  .testi-inner { position: relative; z-index: 10; }

  .testi-header { text-align: center; max-width: 42rem; margin: 0 auto 4rem; }
  .testi-title { font-size: clamp(2.25rem, 5vw, 3.75rem); color: white; }

  .testi-grid { display: grid; gap: 1.5rem; }
  @media (min-width: 768px) { .testi-grid { grid-template-columns: repeat(2, 1fr); } }

  .testi-card {
    position: relative;
    background: rgba(15,46,15,0.4);
    border: 1px solid rgba(34,107,34,0.2);
    border-radius: 2px;
    padding: 2rem;
    transition: border-color 0.5s;
  }
  .testi-card:hover { border-color: rgba(56,163,56,0.3); }

  .testi-stars { display: flex; gap: 4px; margin-bottom: 1.25rem; }
  .testi-star { width: 1rem; height: 1rem; color: var(--acento); }

  .testi-text { color: rgba(255,255,255,0.7); line-height: 1.625; font-size: 0.875rem; }
  @media (min-width: 1024px) { .testi-text { font-size: 1rem; } }

  .testi-author {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(34,107,34,0.2);
  }
  .testi-avatar {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: rgba(34,107,34,0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--verde-300);
  }
  .testi-name { display: block; font-family: var(--font-display); font-size: 0.875rem; font-weight: 700; color: white; }
  .testi-role { display: block; font-family: var(--font-mono); font-size: 0.75rem; color: var(--verde-500); }

  .testi-quote {
    position: absolute;
    top: 1.5rem;
    right: 2rem;
    font-family: var(--font-display);
    font-size: 3.75rem;
    line-height: 1;
    color: rgba(26,74,26,0.3);
    user-select: none;
  }

  /* Trust bar */
  .trust-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    margin-top: 4rem;
    padding-block: 2rem;
    border-top: 1px solid rgba(255,255,255,0.05);
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }
  @media (min-width: 1024px) { .trust-bar { gap: 4rem; } }
  .trust-divider { display: none; width: 1px; height: 2rem; background: rgba(255,255,255,0.1); }
  @media (min-width: 640px) { .trust-divider { display: block; } }
  .trust-item { text-align: center; }
  .trust-value { display: block; font-family: var(--font-display); font-size: 1.875rem; font-weight: 700; color: white; }
  .trust-value--accent { color: var(--acento); }
  .trust-label { display: block; font-family: var(--font-mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; color: rgba(255,255,255,0.3); margin-top: 0.25rem; }
</style>
