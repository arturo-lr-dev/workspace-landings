---
const steps = [
  { num: "01", title: "Contacto", desc: "Agenda tu cita por teléfono, WhatsApp o a través de nuestro formulario. Cuéntanos qué necesita tu vehículo.", icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="24" height="24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>` },
  { num: "02", title: "Diagnóstico", desc: "Realizamos un diagnóstico completo con escáner computarizado para identificar cada detalle. Gratis.", icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="24" height="24"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/><path d="M11 8v6M8 11h6"/></svg>` },
  { num: "03", title: "Presupuesto", desc: "Te entregamos un presupuesto detallado, claro y sin sorpresas. Tú decides si procedemos.", icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="24" height="24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6M9 15h6M9 11h6"/></svg>` },
  { num: "04", title: "Reparación", desc: "Nuestros técnicos certificados realizan el trabajo con piezas de calidad y te mantenemos informado en todo momento.", icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="24" height="24"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>` },
  { num: "05", title: "Entrega", desc: "Tu vehículo listo, funcionando perfecto y con garantía escrita. Te explicamos todo el trabajo realizado.", icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="24" height="24"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>` },
];
---

<section id="proceso" class="section" style="background:white">
  <div class="section-line" style="background:linear-gradient(to right,transparent,rgba(125,216,125,0.4),transparent)"></div>
  <div class="container">
    <div class="proc-header">
      <span class="reveal section-label" style="color:var(--verde-600)">// Cómo trabajamos</span>
      <h2 class="reveal anim-delay-1 section-title proc-title">
        Proceso <span style="color:var(--verde-600)">simple</span>,<br/>resultados perfectos
      </h2>
    </div>

    <div class="proc-steps">
      <div class="proc-connector"></div>
      <div class="proc-grid">
        {steps.map((step, i) => (
          <div class={`reveal anim-delay-${i + 1} proc-step`}>
            <div class="proc-circle">
              <div class="proc-circle-icon"><Fragment set:html={step.icon} /></div>
              <span class="proc-circle-num">{step.num}</span>
            </div>
            <h3 class="proc-step-title">{step.title}</h3>
            <p class="proc-step-desc">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .proc-header { text-align: center; max-width: 42rem; margin: 0 auto 4rem; }
  @media (min-width: 1024px) { .proc-header { margin-bottom: 5rem; } }
  .proc-title { font-size: clamp(2.25rem, 5vw, 3.75rem); color: var(--verde-950); }

  .proc-steps { position: relative; }
  .proc-connector { display: none; }
  @media (min-width: 1024px) {
    .proc-connector {
      display: block;
      position: absolute;
      top: 3.5rem;
      left: 10%;
      right: 10%;
      height: 1px;
      background: linear-gradient(to right, var(--verde-200), var(--verde-400), var(--verde-200));
    }
  }

  .proc-grid { display: grid; gap: 2rem; }
  @media (min-width: 640px) { .proc-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .proc-grid { grid-template-columns: repeat(5, 1fr); gap: 1rem; } }

  .proc-step { position: relative; text-align: center; }

  .proc-circle {
    width: 7rem;
    height: 7rem;
    border-radius: 50%;
    background: var(--verde-50);
    border: 2px solid var(--verde-200);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
    transition: all 0.5s;
  }
  .proc-circle-icon { color: var(--verde-600); transition: color 0.3s; }
  .proc-circle-num { margin-top: 4px; font-family: var(--font-mono); font-size: 10px; font-weight: 700; color: var(--verde-400); transition: color 0.3s; }
  .proc-step:hover .proc-circle { background: var(--verde-600); border-color: var(--verde-600); }
  .proc-step:hover .proc-circle-icon { color: white; }
  .proc-step:hover .proc-circle-num { color: var(--verde-200); }

  .proc-step-title {
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.025em;
    color: var(--verde-950);
  }
  .proc-step-desc { margin-top: 0.5rem; font-size: 0.875rem; color: rgba(74,74,72,0.6); line-height: 1.625; max-width: 220px; margin-inline: auto; }
</style>
