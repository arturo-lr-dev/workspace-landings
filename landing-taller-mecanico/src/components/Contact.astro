---
const contactInfo = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-5 h-5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>`,
    label: "Dirección",
    value: "Av. Insurgentes Sur 1234, Col. Del Valle, CDMX",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-5 h-5"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>`,
    label: "Teléfono",
    value: "(55) 1234-5678",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-5 h-5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6l-10 7L2 6"/></svg>`,
    label: "Email",
    value: "contacto@autotech.mx",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-5 h-5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>`,
    label: "Horario",
    value: "Lun - Sáb: 8:00 AM - 7:00 PM",
  },
];
---

<section id="contacto" class="relative py-24 lg:py-32 bg-humo stripes-pattern overflow-hidden">
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-verde-500/30 to-transparent"></div>

  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16">
      <!-- Left column - Info -->
      <div>
        <span class="reveal inline-block font-mono text-xs uppercase tracking-[0.3em] text-verde-600 mb-4">
          // Contacto
        </span>
        <h2 class="reveal anim-delay-1 font-display text-4xl sm:text-5xl lg:text-6xl font-bold uppercase tracking-tight text-verde-950 leading-[0.95]">
          Agenda tu<br/><span class="text-verde-600">cita hoy</span>
        </h2>
        <p class="reveal anim-delay-2 mt-6 text-lg text-acero/70 leading-relaxed max-w-md">
          Contáctanos y recibe un diagnóstico gratuito. Estamos listos para ayudarte con cualquier problema de tu vehículo.
        </p>

        <!-- Contact info -->
        <div class="mt-10 space-y-6">
          {contactInfo.map((info, i) => (
            <div class={`reveal anim-delay-${i + 3} flex items-start gap-4 group`}>
              <div class="w-10 h-10 bg-verde-100 rounded-sm flex items-center justify-center text-verde-600 shrink-0 group-hover:bg-verde-600 group-hover:text-white transition-all duration-300">
                <Fragment set:html={info.icon} />
              </div>
              <div>
                <span class="block text-xs font-mono uppercase tracking-wider text-verde-500">{info.label}</span>
                <span class="block text-base text-verde-950 font-medium mt-0.5">{info.value}</span>
              </div>
            </div>
          ))}
        </div>

        <!-- WhatsApp CTA -->
        <div class="reveal anim-delay-7 mt-10">
          <a
            href="#"
            class="inline-flex items-center gap-3 px-6 py-3 bg-verde-600 text-white font-display font-bold uppercase tracking-wider text-sm hover:bg-verde-700 transition-colors duration-300 rounded-sm"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            WhatsApp Directo
          </a>
        </div>
      </div>

      <!-- Right column - Form -->
      <div class="reveal anim-delay-2">
        <form class="bg-white border border-verde-100 rounded-sm p-8 lg:p-10 shadow-xl shadow-verde-900/5">
          <h3 class="font-display text-xl font-bold uppercase tracking-wide text-verde-950 mb-8">
            Solicita tu Cita
          </h3>

          <div class="space-y-5">
            <div>
              <label for="nombre" class="block text-xs font-mono uppercase tracking-wider text-verde-600 mb-2">Nombre completo</label>
              <input
                type="text"
                id="nombre"
                name="nombre"
                placeholder="Tu nombre"
                class="w-full px-4 py-3 bg-verde-50/50 border border-verde-100 rounded-sm text-sm text-verde-950 placeholder:text-verde-300 focus:outline-none focus:border-verde-500 focus:bg-white transition-all duration-300"
              />
            </div>

            <div class="grid sm:grid-cols-2 gap-5">
              <div>
                <label for="telefono" class="block text-xs font-mono uppercase tracking-wider text-verde-600 mb-2">Teléfono</label>
                <input
                  type="tel"
                  id="telefono"
                  name="telefono"
                  placeholder="(55) 0000-0000"
                  class="w-full px-4 py-3 bg-verde-50/50 border border-verde-100 rounded-sm text-sm text-verde-950 placeholder:text-verde-300 focus:outline-none focus:border-verde-500 focus:bg-white transition-all duration-300"
                />
              </div>
              <div>
                <label for="email" class="block text-xs font-mono uppercase tracking-wider text-verde-600 mb-2">Email</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  placeholder="tu@email.com"
                  class="w-full px-4 py-3 bg-verde-50/50 border border-verde-100 rounded-sm text-sm text-verde-950 placeholder:text-verde-300 focus:outline-none focus:border-verde-500 focus:bg-white transition-all duration-300"
                />
              </div>
            </div>

            <div>
              <label for="vehiculo" class="block text-xs font-mono uppercase tracking-wider text-verde-600 mb-2">Vehículo (marca, modelo, año)</label>
              <input
                type="text"
                id="vehiculo"
                name="vehiculo"
                placeholder="Ej: Toyota Corolla 2021"
                class="w-full px-4 py-3 bg-verde-50/50 border border-verde-100 rounded-sm text-sm text-verde-950 placeholder:text-verde-300 focus:outline-none focus:border-verde-500 focus:bg-white transition-all duration-300"
              />
            </div>

            <div>
              <label for="servicio" class="block text-xs font-mono uppercase tracking-wider text-verde-600 mb-2">Servicio requerido</label>
              <select
                id="servicio"
                name="servicio"
                class="w-full px-4 py-3 bg-verde-50/50 border border-verde-100 rounded-sm text-sm text-verde-950 focus:outline-none focus:border-verde-500 focus:bg-white transition-all duration-300 appearance-none"
              >
                <option value="">Selecciona un servicio</option>
                <option value="mecanica">Mecánica General</option>
                <option value="diagnostico">Diagnóstico Electrónico</option>
                <option value="preventivo">Servicio Preventivo</option>
                <option value="frenos">Sistema de Frenos</option>
                <option value="electrico">Sistema Eléctrico</option>
                <option value="ac">Aire Acondicionado</option>
                <option value="otro">Otro</option>
              </select>
            </div>

            <div>
              <label for="mensaje" class="block text-xs font-mono uppercase tracking-wider text-verde-600 mb-2">Describe el problema</label>
              <textarea
                id="mensaje"
                name="mensaje"
                rows="3"
                placeholder="Cuéntanos qué le pasa a tu vehículo..."
                class="w-full px-4 py-3 bg-verde-50/50 border border-verde-100 rounded-sm text-sm text-verde-950 placeholder:text-verde-300 focus:outline-none focus:border-verde-500 focus:bg-white transition-all duration-300 resize-none"
              ></textarea>
            </div>
          </div>

          <button
            type="submit"
            class="mt-6 w-full py-4 bg-verde-600 text-white font-display font-bold uppercase tracking-wider text-sm hover:bg-verde-700 active:bg-verde-800 transition-colors duration-300 rounded-sm"
          >
            Enviar Solicitud
          </button>

          <p class="mt-4 text-xs text-acero/40 text-center">
            Responderemos en menos de 2 horas en horario laboral.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>
