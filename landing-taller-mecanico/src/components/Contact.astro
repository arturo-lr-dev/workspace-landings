---
const contactInfo = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="20" height="20"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>`,
    label: "Dirección",
    value: "Av. Insurgentes Sur 1234, Col. Del Valle, CDMX",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="20" height="20"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>`,
    label: "Teléfono",
    value: "(55) 1234-5678",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="20" height="20"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6l-10 7L2 6"/></svg>`,
    label: "Email",
    value: "contacto@autotech.mx",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="20" height="20"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>`,
    label: "Horario",
    value: "Lun - Sáb: 8:00 AM - 7:00 PM",
  },
];
---

<section id="contacto" class="section stripes-bg" style="background-color:var(--humo)">
  <div class="section-line"></div>
  <div class="container">
    <div class="contact-layout">
      <!-- Left column - Info -->
      <div>
        <span class="reveal section-label" style="color:var(--verde-600)">// Contacto</span>
        <h2 class="reveal anim-delay-1 section-title contact-title">
          Agenda tu<br/><span style="color:var(--verde-600)">cita hoy</span>
        </h2>
        <p class="reveal anim-delay-2 contact-desc">
          Contáctanos y recibe un diagnóstico gratuito. Estamos listos para ayudarte con cualquier problema de tu vehículo.
        </p>

        <!-- Contact info -->
        <div class="contact-info">
          {contactInfo.map((info, i) => (
            <div class={`reveal anim-delay-${i + 3} contact-item`}>
              <div class="contact-icon"><Fragment set:html={info.icon} /></div>
              <div>
                <span class="contact-label">{info.label}</span>
                <span class="contact-value">{info.value}</span>
              </div>
            </div>
          ))}
        </div>

        <!-- WhatsApp CTA -->
        <div class="reveal anim-delay-7 contact-wa">
          <a href="#" class="wa-btn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            WhatsApp Directo
          </a>
        </div>
      </div>

      <!-- Right column - Form -->
      <div class="reveal anim-delay-2">
        <form class="contact-form">
          <h3 class="form-title">Solicita tu Cita</h3>

          <div class="form-fields">
            <div class="field">
              <label for="nombre" class="field-label">Nombre completo</label>
              <input type="text" id="nombre" name="nombre" placeholder="Tu nombre" class="field-input" />
            </div>

            <div class="field-row">
              <div class="field">
                <label for="telefono" class="field-label">Teléfono</label>
                <input type="tel" id="telefono" name="telefono" placeholder="(55) 0000-0000" class="field-input" />
              </div>
              <div class="field">
                <label for="email" class="field-label">Email</label>
                <input type="email" id="email" name="email" placeholder="tu@email.com" class="field-input" />
              </div>
            </div>

            <div class="field">
              <label for="vehiculo" class="field-label">Vehículo (marca, modelo, año)</label>
              <input type="text" id="vehiculo" name="vehiculo" placeholder="Ej: Toyota Corolla 2021" class="field-input" />
            </div>

            <div class="field">
              <label for="servicio" class="field-label">Servicio requerido</label>
              <select id="servicio" name="servicio" class="field-input field-select">
                <option value="">Selecciona un servicio</option>
                <option value="mecanica">Mecánica General</option>
                <option value="diagnostico">Diagnóstico Electrónico</option>
                <option value="preventivo">Servicio Preventivo</option>
                <option value="frenos">Sistema de Frenos</option>
                <option value="electrico">Sistema Eléctrico</option>
                <option value="ac">Aire Acondicionado</option>
                <option value="otro">Otro</option>
              </select>
            </div>

            <div class="field">
              <label for="mensaje" class="field-label">Describe el problema</label>
              <textarea id="mensaje" name="mensaje" rows="3" placeholder="Cuéntanos qué le pasa a tu vehículo..." class="field-input field-textarea"></textarea>
            </div>
          </div>

          <button type="submit" class="form-submit">Enviar Solicitud</button>
          <p class="form-note">Responderemos en menos de 2 horas en horario laboral.</p>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-layout { display: grid; gap: 4rem; }
  @media (min-width: 1024px) { .contact-layout { grid-template-columns: 1fr 1fr; } }

  .contact-title { font-size: clamp(2.25rem, 5vw, 3.75rem); color: var(--verde-950); }
  .contact-desc { margin-top: 1.5rem; font-size: 1.125rem; color: rgba(74,74,72,0.7); line-height: 1.625; max-width: 28rem; }

  /* Contact info */
  .contact-info { margin-top: 2.5rem; display: flex; flex-direction: column; gap: 1.5rem; }
  .contact-item { display: flex; align-items: flex-start; gap: 1rem; }
  .contact-icon {
    width: 2.5rem;
    height: 2.5rem;
    background: var(--verde-100);
    border-radius: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--verde-600);
    flex-shrink: 0;
    transition: all 0.3s;
  }
  .contact-item:hover .contact-icon { background: var(--verde-600); color: white; }
  .contact-label { display: block; font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--verde-500); }
  .contact-value { display: block; font-size: 1rem; color: var(--verde-950); font-weight: 500; margin-top: 2px; }

  /* WhatsApp */
  .contact-wa { margin-top: 2.5rem; }
  .wa-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1.5rem;
    background: var(--verde-600);
    color: white;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 2px;
    transition: background 0.3s;
  }
  .wa-btn:hover { background: var(--verde-700); }

  /* Form */
  .contact-form {
    background: white;
    border: 1px solid var(--verde-100);
    border-radius: 2px;
    padding: 2rem;
    box-shadow: 0 25px 50px -12px rgba(45,138,45,0.05);
  }
  @media (min-width: 1024px) { .contact-form { padding: 2.5rem; } }

  .form-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.025em;
    color: var(--verde-950);
    margin-bottom: 2rem;
  }

  .form-fields { display: flex; flex-direction: column; gap: 1.25rem; }
  .field-row { display: grid; gap: 1.25rem; }
  @media (min-width: 640px) { .field-row { grid-template-columns: 1fr 1fr; } }

  .field-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--verde-600);
    margin-bottom: 0.5rem;
  }
  .field-input {
    width: 100%;
    padding: 0.75rem 1rem;
    background: rgba(232,248,232,0.5);
    border: 1px solid var(--verde-100);
    border-radius: 2px;
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--verde-950);
    transition: all 0.3s;
  }
  .field-input::placeholder { color: var(--verde-300); }
  .field-input:focus { outline: none; border-color: var(--verde-500); background: white; }
  .field-select { appearance: none; }
  .field-textarea { resize: none; }

  .form-submit {
    margin-top: 1.5rem;
    width: 100%;
    padding: 1rem;
    background: var(--verde-600);
    color: white;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: none;
    border-radius: 2px;
    cursor: pointer;
    transition: background 0.3s;
  }
  .form-submit:hover { background: var(--verde-700); }
  .form-submit:active { background: var(--verde-800); }

  .form-note { margin-top: 1rem; font-size: 0.75rem; color: rgba(74,74,72,0.4); text-align: center; }
</style>
