---
const features = [
  { num: "01", title: "Técnicos Certificados", desc: "Personal con certificación ASE y capacitación continua en las últimas tecnologías automotrices." },
  { num: "02", title: "Equipo de Punta", desc: "Herramientas y escáneres de última generación para diagnósticos precisos y reparaciones eficientes." },
  { num: "03", title: "Garantía Total", desc: "Respaldamos cada reparación con garantía escrita. Tu tranquilidad es nuestra prioridad." },
  { num: "04", title: "Precios Justos", desc: "Presupuesto detallado y transparente antes de cualquier trabajo. Sin costos ocultos." },
];
---

<section id="nosotros" class="relative py-24 lg:py-32 bg-verde-950 overflow-hidden">
  <!-- Background effects -->
  <div class="absolute inset-0">
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-verde-600/10 rounded-full blur-[120px]"></div>
    <div class="absolute bottom-0 left-1/4 w-[400px] h-[400px] bg-acento/5 rounded-full blur-[100px]"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(200,255,0,0.4) 1px, transparent 1px), linear-gradient(90deg, rgba(200,255,0,0.4) 1px, transparent 1px); background-size: 40px 40px;"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-20 items-start">
      <!-- Left column -->
      <div>
        <span class="reveal inline-block font-mono text-xs uppercase tracking-[0.3em] text-verde-400 mb-4">
          // Sobre nosotros
        </span>
        <h2 class="reveal anim-delay-1 font-display text-4xl sm:text-5xl lg:text-6xl font-bold uppercase tracking-tight text-white leading-[0.95]">
          Más que un<br/>
          <span class="text-gradient-green">taller</span>,<br/>
          tu aliado
        </h2>
        <p class="reveal anim-delay-2 mt-8 text-lg text-white/50 leading-relaxed max-w-md">
          Con más de dos décadas de experiencia, combinamos la pasión por la mecánica automotriz con la tecnología más avanzada del mercado.
        </p>

        <!-- Big number accent -->
        <div class="reveal anim-delay-3 mt-12 flex items-end gap-4">
          <span class="text-8xl lg:text-9xl font-display font-bold text-acento leading-none">20</span>
          <div class="mb-3">
            <span class="block text-xl font-display font-bold uppercase text-white">Años de</span>
            <span class="block text-xl font-display font-bold uppercase text-verde-400">Excelencia</span>
          </div>
        </div>
      </div>

      <!-- Right column - Features -->
      <div class="space-y-0">
        {features.map((feat, i) => (
          <div class={`reveal anim-delay-${i + 2} group flex gap-6 py-7 border-b border-white/10 first:border-t hover:border-verde-500/30 transition-colors cursor-default`}>
            <span class="font-mono text-sm text-verde-500 mt-1 shrink-0">{feat.num}</span>
            <div>
              <h3 class="font-display text-lg font-bold uppercase tracking-wide text-white group-hover:text-acento transition-colors duration-300">
                {feat.title}
              </h3>
              <p class="mt-2 text-sm text-white/40 leading-relaxed group-hover:text-white/60 transition-colors duration-300">
                {feat.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
